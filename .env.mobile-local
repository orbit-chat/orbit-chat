# `npm run build:mobile:local`: a phone build for testing against an orbit-server on this
# computer, reached over USB with `adb reverse tcp:3000 tcp:3000`. Only loopback addresses are
# accepted (the build and the app both refuse anything else), and only Android debug builds allow
# plain HTTP to them (android/app/src/debug/res/xml/network_security_config.xml).
# Install with `npm run cap:sync` and `cd android && ./gradlew installDebug`.
VITE_API_URL=http://localhost:3000
VITE_SOCKET_URL=http://localhost:3000
VITE_MEDIA_ORIGIN=http://localhost:9000
