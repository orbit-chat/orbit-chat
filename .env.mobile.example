# Copy to .env.mobile for `npm run build:mobile` (vite --mode mobile). Phones require TLS: the
# app refuses a non-HTTPS server address (mobile plan B3), and the CSP only allows these origins.
VITE_API_URL=https://chat.example.com
VITE_SOCKET_URL=https://chat.example.com
# Where avatars, banners and encrypted attachments are downloaded from (S3/MinIO endpoint).
VITE_MEDIA_ORIGIN=https://media.example.com
