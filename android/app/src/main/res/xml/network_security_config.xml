<?xml version="1.0" encoding="utf-8"?>
<!-- TLS only, system CAs only (no user-installed CAs that could intercept traffic). Certificate
     pinning waits for a stable production hostname (mobile plan B3). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
